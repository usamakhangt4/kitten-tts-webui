# Copy to .env and edit. Relative paths are resolved from the repo root.

# Address and port the web UI binds to. Keep 127.0.0.1: the server has no authentication.
KITTEN_WEBUI_HOST=127.0.0.1
KITTEN_WEBUI_PORT=7860

# Where generated .wav clips (and their .json sidecars) are saved.
KITTEN_OUTPUT_DIR=./output

# Base cache folder (torch cache goes in here).
KITTEN_CACHE_DIR=./cache

# Hugging Face cache: the KittenTTS 2 weights are downloaded here on first run.
HF_HOME=./cache/hf

# Scratch folder for temporary files.
KITTEN_TMP_DIR=./tmp

# Set to 1 to start the server without loading the model (UI/API testing only).
KITTEN_SKIP_MODEL_LOAD=0
